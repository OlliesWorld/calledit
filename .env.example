# ===========================================
# LaunchKit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Run `npm run validate-setup` to verify your configuration

# App URL (required for secure redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Clerk Authentication (required)
# Get these from: https://dashboard.clerk.com
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ===========================================
# Supabase Database (required)
# Get these from: https://supabase.com/dashboard
# ===========================================
# The app only talks to Supabase from the server, with the secret key.
# No anon/publishable key is needed (migration 008 revokes its table access).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Stripe Payments (optional, not used in v1)
# Get these from: https://dashboard.stripe.com
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=

# ===========================================
# Anthropic (admin question generation)
# ===========================================
ANTHROPIC_API_KEY=

# ===========================================
# CalledIt Admin
# Comma-separated Clerk user IDs for admin access
# ===========================================
ADMIN_USER_IDS=
