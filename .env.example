# ===========================================
# LaunchKit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Run `npm run validate-setup` to verify your configuration

# App URL (required for secure redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Clerk Authentication (required)
# Get these from: https://dashboard.clerk.com
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ===========================================
# Supabase Database (required)
# Get these from: https://supabase.com/dashboard
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ===========================================
# Stripe Payments (required for payments)
# Get these from: https://dashboard.stripe.com
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=

# ===========================================
# AI Providers (optional - for AI chat feature)
# ===========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===========================================
# CalledIt Admin
# Comma-separated Clerk user IDs for admin access
# ===========================================
ADMIN_USER_IDS=
GOOGLE_GENERATIVE_AI_API_KEY=
