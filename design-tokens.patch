diff --git a/scripts/build-tokens.mjs b/scripts/build-tokens.mjs
new file mode 100644
index 0000000..38ecfe2
--- /dev/null
+++ b/scripts/build-tokens.mjs
@@ -0,0 +1,80 @@
+// Reads design-tokens/tokens.json (W3C DTCG format, as exported by Penpot)
+// and writes src/styles/tokens.generated.css for Tailwind v4's @theme.
+// Run: npm run tokens
+import { readFileSync, writeFileSync } from 'node:fs'
+import { dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+const src = resolve(root, 'design-tokens/tokens.json')
+const out = resolve(root, 'src/styles/tokens.generated.css')
+
+const tree = JSON.parse(readFileSync(src, 'utf8'))
+
+// Flatten the token tree into [path[], token] pairs, carrying $type down.
+function walk(node, path = [], inheritedType) {
+  const rows = []
+  const type = node.$type ?? inheritedType
+  for (const [key, value] of Object.entries(node)) {
+    if (key.startsWith('$')) continue
+    if (value && typeof value === 'object' && '$value' in value) {
+      rows.push([[...path, key], { ...value, $type: value.$type ?? type }])
+    } else if (value && typeof value === 'object') {
+      rows.push(...walk(value, [...path, key], type))
+    }
+  }
+  return rows
+}
+
+// Penpot and Tokens Studio use slightly different $type names, so accept both.
+const TYPE_GROUP = {
+  color: 'color',
+  borderradius: 'radius',
+  dimension: 'radius',
+  shadow: 'shadow',
+  boxshadow: 'shadow',
+  fontfamily: 'font',
+  fontfamilies: 'font',
+}
+
+const px = (v) => (/^-?\d+(\.\d+)?$/.test(String(v)) ? `${v}px` : String(v))
+const shadowCss = (s) => `${px(s.offsetX)} ${px(s.offsetY)} ${px(s.blur)} ${px(s.spread)} ${s.color}`
+
+const lines = []
+const fontLines = []
+for (const [path, token] of walk(tree)) {
+  const group = TYPE_GROUP[String(token.$type).toLowerCase()]
+  if (!group) {
+    console.warn(`skip ${path.join('.')}: unknown $type "${token.$type}"`)
+    continue
+  }
+  const name = path.slice(1).join('-')
+  const v = token.$value
+  if (group === 'color') lines.push(`  --color-${name}: ${v};`)
+  if (group === 'radius') lines.push(`  --radius-${name}: ${px(v)};`)
+  if (group === 'shadow') {
+    const list = Array.isArray(v) ? v : [v]
+    lines.push(`  --shadow-${name}: ${list.map(shadowCss).join(', ')};`)
+  }
+  if (group === 'font') {
+    // Prefer the next/font variable when present, fall back to the family name
+    // (Storybook has no next/font).
+    const generic = name === 'mono' ? 'monospace' : 'sans-serif'
+    fontLines.push(`  --font-${name}: var(--font-${{ display: 'bebas', sans: 'dm-sans', mono: 'dm-mono' }[name] ?? name}, "${v}"), ${generic};`)
+  }
+}
+
+const css = `/* GENERATED by scripts/build-tokens.mjs from design-tokens/tokens.json.
+   Do not edit by hand. Change the tokens in Penpot, export, then run \`npm run tokens\`. */
+@theme {
+${lines.join('\n')}
+}
+
+/* inline: next/font sets its variables below :root, so the value must be
+   substituted into each utility instead of resolved at :root. */
+@theme inline {
+${fontLines.join('\n')}
+}
+`
+writeFileSync(out, css)
+console.log(`wrote ${out} (${lines.length + fontLines.length} tokens)`)
diff --git a/scripts/visual-diff.mjs b/scripts/visual-diff.mjs
new file mode 100644
index 0000000..6e801e8
--- /dev/null
+++ b/scripts/visual-diff.mjs
@@ -0,0 +1,67 @@
+// Screenshots every story in a built Storybook and, if a baseline folder is
+// given, reports the pixel difference per story.
+//
+//   npm run build-storybook
+//   node scripts/visual-diff.mjs --static storybook-static --out shots/after --baseline shots/before
+//
+// The baseline can be the previous build, or exports from Penpot named by story
+// id (for example picks-questioncard--open.png) to compare design against build.
+import { createServer } from 'node:http'
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import handler from 'serve-handler'
+import puppeteer from 'puppeteer-core'
+import pixelmatch from 'pixelmatch'
+import { PNG } from 'pngjs'
+
+const args = Object.fromEntries(
+  process.argv.slice(2).reduce((acc, a, i, all) => (a.startsWith('--') ? [...acc, [a.slice(2), all[i + 1]]] : acc), [])
+)
+const staticDir = resolve(args.static ?? 'storybook-static')
+const outDir = resolve(args.out ?? 'shots/current')
+const baselineDir = args.baseline ? resolve(args.baseline) : null
+const chrome = args.chrome ?? process.env.CHROME_PATH ?? '/usr/bin/google-chrome'
+mkdirSync(outDir, { recursive: true })
+
+const index = JSON.parse(readFileSync(resolve(staticDir, 'index.json'), 'utf8'))
+const stories = Object.values(index.entries).filter((e) => e.type === 'story')
+
+const server = createServer((req, res) => handler(req, res, { public: staticDir, cleanUrls: false }))
+await new Promise((r) => server.listen(0, r))
+const base = `http://localhost:${server.address().port}`
+
+const browser = await puppeteer.launch({ executablePath: chrome, args: ['--no-sandbox'] })
+const page = await browser.newPage()
+await page.setViewport({ width: 600, height: 500, deviceScaleFactor: 2 })
+
+const rows = []
+for (const story of stories) {
+  await page.goto(`${base}/iframe.html?id=${story.id}&viewMode=story`, { waitUntil: 'networkidle2', timeout: 30000 }).catch(() => {})
+  await page.evaluate(() => document.fonts.ready)
+  // Let the fade-up animation finish so frames are comparable.
+  await new Promise((r) => setTimeout(r, 900))
+  const el = await page.$('#storybook-root')
+  const file = resolve(outDir, `${story.id}.png`)
+  await el.screenshot({ path: file })
+
+  let diffPct = null
+  const basePng = baselineDir && resolve(baselineDir, `${story.id}.png`)
+  if (basePng && existsSync(basePng)) {
+    const a = PNG.sync.read(readFileSync(basePng))
+    const b = PNG.sync.read(readFileSync(file))
+    if (a.width !== b.width || a.height !== b.height) {
+      diffPct = 100
+    } else {
+      const diff = new PNG({ width: a.width, height: a.height })
+      const n = pixelmatch(a.data, b.data, diff.data, a.width, a.height, { threshold: 0.1 })
+      diffPct = +((n / (a.width * a.height)) * 100).toFixed(4)
+      if (n > 0) writeFileSync(resolve(outDir, `${story.id}.diff.png`), PNG.sync.write(diff))
+    }
+  }
+  rows.push({ story: story.id, diffPct })
+}
+await browser.close()
+server.close()
+
+writeFileSync(resolve(outDir, 'report.json'), JSON.stringify(rows, null, 2))
+console.table(rows)
