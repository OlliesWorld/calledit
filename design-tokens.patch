@@ -0,0 +1,30 @@
+/* GENERATED by scripts/build-tokens.mjs from design-tokens/tokens.json.
+   Do not edit by hand. Change the tokens in Penpot, export, then run `npm run tokens`. */
+@theme {
+  --color-canvas: #0A0A0B;
+  --color-surface: #111114;
+  --color-surface2: #1A1A1F;
+  --color-surface3: #222228;
+  --color-surface4: #2A2A30;
+  --color-ink: #F5F5F0;
+  --color-ink-muted: rgba(245, 245, 240, 0.45);
+  --color-line: rgba(255, 255, 255, 0.08);
+  --color-orange: #FF5F1F;
+  --color-coral: #FF3B6E;
+  --color-lime: #B8FF3A;
+  --color-violet: #8B5CF6;
+  --color-gold: #FFD166;
+  --radius-card: 14px;
+  --radius-field: 10px;
+  --radius-chip: 8px;
+  --shadow-glow-orange: 0px 0px 20px 0px rgba(255, 95, 31, 0.4);
+  --shadow-glow-coral: 0px 0px 20px 0px rgba(255, 59, 110, 0.4);
+}
+
+/* inline: next/font sets its variables below :root, so the value must be
+   substituted into each utility instead of resolved at :root. */
+@theme inline {
+  --font-display: var(--font-bebas, "Bebas Neue"), sans-serif;
+  --font-sans: var(--font-dm-sans, "DM Sans"), sans-serif;
+  --font-mono: var(--font-dm-mono, "DM Mono"), monospace;
+}
