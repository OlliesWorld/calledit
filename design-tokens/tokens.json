{
  "color": {
    "$type": "color",
    "canvas": { "$value": "#0A0A0B", "$description": "Page background" },
    "surface": { "$value": "#111114", "$description": "Header and nav surface" },
    "surface2": { "$value": "#1A1A1F", "$description": "Card surface" },
    "surface3": { "$value": "#222228", "$description": "Field and button surface" },
    "surface4": { "$value": "#2A2A30", "$description": "Hover surface" },
    "ink": { "$value": "#F5F5F0", "$description": "Primary text" },
    "ink-muted": { "$value": "rgba(245, 245, 240, 0.45)", "$description": "Secondary text" },
    "line": { "$value": "rgba(255, 255, 255, 0.08)", "$description": "Subtle border" },
    "orange": { "$value": "#FF5F1F", "$description": "Brand primary, YES pick" },
    "coral": { "$value": "#FF3B6E", "$description": "NO pick, wrong answer, destructive" },
    "lime": { "$value": "#B8FF3A", "$description": "Correct answer" },
    "violet": { "$value": "#8B5CF6", "$description": "Flavor text and tiebreaker" },
    "gold": { "$value": "#FFD166", "$description": "Highlight" }
  },
  "radius": {
    "$type": "borderRadius",
    "card": { "$value": "14", "$description": "Cards and pick buttons" },
    "field": { "$value": "10", "$description": "Inputs and callouts" },
    "chip": { "$value": "8", "$description": "League pills" }
  },
  "shadow": {
    "$type": "shadow",
    "glow-orange": {
      "$value": { "color": "rgba(255, 95, 31, 0.4)", "offsetX": "0", "offsetY": "0", "blur": "20", "spread": "0" },
      "$description": "Selected YES pick glow"
    },
    "glow-coral": {
      "$value": { "color": "rgba(255, 59, 110, 0.4)", "offsetX": "0", "offsetY": "0", "blur": "20", "spread": "0" },
      "$description": "Selected NO pick glow"
    }
  },
  "font": {
    "$type": "fontFamilies",
    "display": { "$value": "Bebas Neue", "$description": "Headlines and pick buttons" },
    "sans": { "$value": "DM Sans", "$description": "Body text" },
    "mono": { "$value": "DM Mono", "$description": "Labels and badges" }
  }
}
